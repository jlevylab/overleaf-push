{
  "manifest_version": 3,
  "name": "Overleaf to git",
  "version": "0.1.0",
  "description": "One button in Overleaf: recompile, then commit the project and its PDF straight to GitHub.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.overleaf.com/*",
    "https://api.github.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.overleaf.com/project/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "Overleaf to git (open settings)" }
}
